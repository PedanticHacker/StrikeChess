QCheckBox, QGroupBox, QRadioButton {
  color: #3a1066;
}

QCheckBox:disabled, QGroupBox:disabled, QRadioButton:disabled {
  color: #6a3999;
}

QCheckBox::indicator {
  border-radius: 3px;
}

QCheckBox::indicator, QRadioButton::indicator {
  background-color: transparent;
  border: 1px solid #3a1066;
  height: 12px;
  margin: 3px 0px;
  width: 12px;
}

QCheckBox::indicator:checked {
  background-clip: content;
  background-color: #3a1066;
  height: 8px;
  padding: 2px;
  width: 8px;
}

QCheckBox::indicator:checked:disabled {
  background-color: #6a3999;
}

QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
  border: 1px solid #6a3999;
}

QCheckBox::indicator:unchecked:hover, QRadioButton::indicator:unchecked:hover {
  background-color: #d395ff;
}

QDialog {
  background-color: #c385f7;
  border: 1px solid #9d4ee6;
  border-radius: 4px;
}

QHeaderView {
  background-color: #c385f7;
  border-bottom: 1px solid #9d4ee6;
  color: #3a1066;
}

QLabel {
  color: #3a1066;
}

#engineAnalysis {
  background-color: #d395ff;
  border: 1px solid #9d4ee6;
  border-radius: 4px;
  qproperty-alignment: AlignTop;
}

#engineName, #humanName, #notifications {
  background-color: #d395ff;
  border: 1px solid #9d4ee6;
  border-radius: 4px;
  qproperty-alignment: AlignCenter;
}

QLineEdit {
  background-color: #d395ff;
  border: 1px solid #9d4ee6;
  border-radius: 4px;
  color: #3a1066;
  qproperty-alignment: AlignCenter;
}

QLineEdit:disabled {
  color: #6a3999;
}

QLineEdit:focus {
  background-color: #c385f7;
  border: 1px solid #3a1066;
}

QLineEdit:hover {
  background-color: #c98af9;
  border: 1px solid #8832d9;
}

QLineEdit[invalid="true"] {
  background-color: red;
  border: 1px solid darkred;
  color: black;
}

QMainWindow {
  background-color: #c385f7;
  border: 1px solid #9d4ee6;
  qproperty-disabled_icon_color: #6a3999;
  qproperty-icon_color: #3a1066;
}

QMenu {
  background-color: #d395ff;
  border: 1px solid #9d4ee6;
  border-radius: 4px;
  padding: 6px 6px 6px 10px;
}

QMenu::item {
  background-color: transparent;
  color: #3a1066;
  margin: 2px;
  padding: 4px 20px 4px 20px;
}

QMenu::item:disabled {
  color: #6a3999;
}

QMenu::item:selected {
  background-color: #b375e7;
  border-radius: 2px;
}

QMenu::separator {
  background-color: #9d4ee6;
  height: 1px;
  margin: 8px;
}

QMenuBar {
  background-color: #c385f7;
  border-bottom: 1px solid #9d4ee6;
  color: #3a1066;
  font-weight: bold;
}

QMenuBar::item:selected {
  background-color: #d395ff;
}

QPushButton {
  background-color: #9d4ee6;
  border-radius: 4px;
  color: #ffffff;
  font-weight: bold;
  padding: 8px 16px;
}

QPushButton:disabled {
  background-color: #d395ff;
  color: #6a3999;
}

QPushButton:hover {
  background-color: #8832d9;
}

QPushButton:pressed {
  background-color: #3a1066;
}

QProgressBar {
  background-color: white;
  border: 1px solid #9d4ee6;
  border-radius: 4px;
  color: #9c4ce6;
  font-weight: bold;
  text-align: center;
}

QProgressBar::chunk {
  background-color: black;
  border-radius: 3px;
}

QRadioButton::indicator {
  border-radius: 7px;
}

QRadioButton::indicator:checked {
  background-color: qradialgradient(
    cx: 0.5, cy: 0.5, radius: 0.5, fx: 0.5, fy: 0.5,
    stop: 0 #3a1066, stop: 0.45 #3a1066, stop: 0.55 transparent, stop: 1 transparent
  );
}

QRadioButton::indicator:checked:disabled {
  background-color: qradialgradient(
    cx: 0.5, cy: 0.5, radius: 0.5, fx: 0.5, fy: 0.5,
    stop: 0 #6a3999, stop: 0.45 #6a3999, stop: 0.55 transparent, stop: 1 transparent
  );
}

QStatusBar {
  background-color: #c385f7;
  border-top: 1px solid #9d4ee6;
  color: #3a1066;
}

QStatusBar QLabel {
  padding-left: 1px;
  padding-right: 1px;
}

QTableView {
  background-color: #d395ff;
  border: 1px solid #9d4ee6;
  border-radius: 4px;
  color: #3a1066;
  gridline-color: #9d4ee6;
  selection-background-color: #b375e7;
  selection-color: #3a1066;
}

QTableView::item:hover {
  background-color: #b375e7;
}

QToolBar {
  background-color: #c385f7;
  border-bottom: 1px solid #9d4ee6;
  padding: 4px;
  spacing: 4px;
}

QToolTip {
  background-color: #d395ff;
  border: 1px solid #b375e7;
  border-radius: 4px;
  color: #3a1066;
  font-weight: bold;
}

SvgBoard {
  qproperty-coord: #3a1066;
  qproperty-inner_border: #9d4ee6;
  qproperty-margin: #d395ff;
  qproperty-outer_border: #3a1066;
  qproperty-square_dark: #a346f2;
  qproperty-square_dark_lastmove: #9339e0;
  qproperty-square_light: #e9ccff;
  qproperty-square_light_lastmove: #b375e7;
}
