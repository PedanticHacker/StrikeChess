QCheckBox, QGroupBox, QRadioButton {
  color: #1c4b45;
}

QCheckBox:disabled, QGroupBox:disabled, QRadioButton:disabled {
  color: #42726c;
}

QCheckBox::indicator {
  border-radius: 3px;
}

QCheckBox::indicator, QRadioButton::indicator {
  background-color: transparent;
  border: 1px solid #1c4b45;
  height: 12px;
  margin: 3px 0px;
  width: 12px;
}

QCheckBox::indicator:checked {
  background-clip: content;
  background-color: #1c4b45;
  height: 8px;
  padding: 2px;
  width: 8px;
}

QCheckBox::indicator:checked:disabled {
  background-color: #42726c;
}

QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
  border: 1px solid #42726c;
}

QCheckBox::indicator:unchecked:hover, QRadioButton::indicator:unchecked:hover {
  background-color: #a7dbd5;
}

QDialog {
  background-color: #97cbc5;
  border: 1px solid #7ac7bd;
  border-radius: 4px;
}

QHeaderView {
  background-color: #97cbc5;
  border-bottom: 1px solid #7ac7bd;
  color: #1c4b45;
}

QLabel {
  color: #1c4b45;
}

#engineAnalysis {
  background-color: #a7dbd5;
  border: 1px solid #7ac7bd;
  border-radius: 4px;
  qproperty-alignment: AlignTop;
}

#engineName, #humanName, #notifications {
  background-color: #a7dbd5;
  border: 1px solid #7ac7bd;
  border-radius: 4px;
  qproperty-alignment: AlignCenter;
}

QLineEdit {
  background-color: #a7dbd5;
  border: 1px solid #7ac7bd;
  border-radius: 4px;
  color: #1c4b45;
  qproperty-alignment: AlignCenter;
}

QLineEdit:disabled {
  color: #42726c;
}

QLineEdit:focus {
  background-color: #97cbc5;
  border: 1px solid #1c4b45;
}

QLineEdit:hover {
  background-color: #9dcdc7;
  border: 1px solid #4db3a7;
}

QLineEdit[invalid="true"] {
  background-color: red;
  border: 1px solid darkred;
  color: black;
}

QMainWindow {
  background-color: #97cbc5;
  border: 1px solid #7ac7bd;
  qproperty-disabled_icon_color: #42726c;
  qproperty-icon_color: #1c4b45;
}

QMenu {
  background-color: #a7dbd5;
  border: 1px solid #7ac7bd;
  border-radius: 4px;
  padding: 6px 6px 6px 10px;
}

QMenu::item {
  background-color: transparent;
  color: #1c4b45;
  margin: 2px;
  padding: 4px 20px 4px 20px;
}

QMenu::item:disabled {
  color: #42726c;
}

QMenu::item:selected {
  background-color: #87bbb5;
  border-radius: 2px;
}

QMenu::separator {
  background-color: #7ac7bd;
  height: 1px;
  margin: 8px;
}

QMenuBar {
  background-color: #97cbc5;
  border-bottom: 1px solid #7ac7bd;
  color: #1c4b45;
  font-weight: bold;
}

QMenuBar::item:selected {
  background-color: #a7dbd5;
}

QPushButton {
  background-color: #368177;
  border-radius: 4px;
  color: #ffffff;
  font-weight: bold;
  padding: 8px 16px;
}

QPushButton:disabled {
  background-color: #a7dbd5;
  color: #42726c;
}

QPushButton:hover {
  background-color: #2d6a62;
}

QPushButton:pressed {
  background-color: #1c4b45;
}

QProgressBar {
  background-color: white;
  border: 1px solid #7ac7bd;
  border-radius: 4px;
  color: #368177;
  font-weight: bold;
  text-align: center;
}

QProgressBar::chunk {
  background-color: black;
  border-radius: 3px;
}

QRadioButton::indicator {
  border-radius: 7px;
}

QRadioButton::indicator:checked {
  background-color: qradialgradient(
    cx: 0.5, cy: 0.5, radius: 0.5, fx: 0.5, fy: 0.5,
    stop: 0 #1c4b45, stop: 0.45 #1c4b45, stop: 0.55 transparent, stop: 1 transparent
  );
}

QRadioButton::indicator:checked:disabled {
  background-color: qradialgradient(
    cx: 0.5, cy: 0.5, radius: 0.5, fx: 0.5, fy: 0.5,
    stop: 0 #42726c, stop: 0.45 #42726c, stop: 0.55 transparent, stop: 1 transparent
  );
}

QStatusBar {
  background-color: #97cbc5;
  border-top: 1px solid #7ac7bd;
  color: #1c4b45;
}

QStatusBar QLabel {
  padding-left: 1px;
  padding-right: 1px;
}

QTableView {
  background-color: #a7dbd5;
  border: 1px solid #7ac7bd;
  border-radius: 4px;
  color: #1c4b45;
  gridline-color: #7ac7bd;
  selection-background-color: #87bbb5;
  selection-color: #1c4b45;
}

QTableView::item:hover {
  background-color: #87bbb5;
}

QToolBar {
  background-color: #97cbc5;
  border-bottom: 1px solid #7ac7bd;
  padding: 4px;
  spacing: 4px;
}

QToolTip {
  background-color: #a7dbd5;
  border: 1px solid #87bbb5;
  border-radius: 4px;
  color: #1c4b45;
  font-weight: bold;
}

SvgBoard {
  qproperty-coord: #1c4b45;
  qproperty-inner_border: #7ac7bd;
  qproperty-margin: #a7dbd5;
  qproperty-outer_border: #1c4b45;
  qproperty-square_dark: #65b0a7;
  qproperty-square_dark_lastmove: #4d9e94;
  qproperty-square_light: #d4efe9;
  qproperty-square_light_lastmove: #87bbb5;
}
