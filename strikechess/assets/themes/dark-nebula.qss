QCheckBox, QGroupBox, QRadioButton {
  color: #e2d4f5;
}

QCheckBox::indicator {
  border-radius: 3px;
}

QCheckBox::indicator, QRadioButton::indicator {
  background-color: transparent;
  border: 1px solid #e2d4f5;
  height: 12px;
  margin: 3px 0px;
  width: 12px;
}

QCheckBox::indicator:checked {
  background-clip: content;
  background-color: #e2d4f5;
  height: 8px;
  padding: 2px;
  width: 8px;
}

QCheckBox::indicator:unchecked:hover, QRadioButton::indicator:unchecked:hover {
  background-color: #6b35b0;
}

QDialog {
  background-color: #351d4d;
  border: 1px solid #6b35b0;
  border-radius: 4px;
}

QHeaderView {
  background-color: #351d4d;
  border-bottom: 1px solid #6b35b0;
  color: #e2d4f5;
}

QLabel {
  color: #e2d4f5;
}

#engineAnalysis {
  background-color: #3d2159;
  border: 1px solid #6b35b0;
  border-radius: 4px;
  qproperty-alignment: AlignTop;
}

#engineName, #humanName, #notifications {
  background-color: #3d2159;
  border: 1px solid #6b35b0;
  border-radius: 4px;
  qproperty-alignment: AlignCenter;
}

QLineEdit {
  background-color: #3d2159;
  border: 1px solid #6b35b0;
  border-radius: 4px;
  color: #e2d4f5;
  qproperty-alignment: AlignCenter;
}

QLineEdit:focus {
  background-color: #351d4d;
  border: 1px solid #8e45d4;
}

QLineEdit:hover {
  background-color: #452666;
  border: 1px solid #8e45d4;
}

QLineEdit[invalid="true"] {
  background-color: red;
  border: 1px solid darkred;
  color: black;
}

QMainWindow {
  background-color: #351d4d;
  border: 1px solid #6b35b0;
}

QMenu {
  background-color: #3d2159;
  border: 1px solid #6b35b0;
  border-radius: 4px;
  padding: 6px 6px 6px 10px;
}

QMenu::item {
  background-color: transparent;
  color: #e2d4f5;
  margin: 2px;
  padding: 4px 20px 4px 20px;
}

QMenu::item:selected {
  background-color: #6b35b0;
  border-radius: 2px;
}

QMenu::separator {
  background-color: #6b35b0;
  height: 1px;
  margin: 8px;
}

QMenuBar {
  background-color: #351d4d;
  border-bottom: 1px solid #6b35b0;
  color: #e2d4f5;
  font-weight: bold;
}

QMenuBar::item:selected {
  background-color: #6b35b0;
}

QPushButton {
  background-color: #6b35b0;
  border-radius: 4px;
  color: #ffffff;
  font-weight: bold;
  padding: 8px 16px;
}

QPushButton:disabled {
  background-color: #3d2159;
  color: #9c8fab;
}

QPushButton:hover {
  background-color: #8e45d4;
}

QPushButton:pressed {
  background-color: #3d2159;
}

QProgressBar {
  background-color: white;
  border: 1px solid #6b35b0;
  border-radius: 4px;
  color: #8e5cce;
  font-weight: bold;
  text-align: center;
}

QProgressBar::chunk {
  background-color: black;
  border-radius: 3px;
}

QRadioButton::indicator {
  border-radius: 7px;
}

QRadioButton::indicator:checked {
  background-color: qradialgradient(
    cx: 0.5, cy: 0.5, radius: 0.5, fx: 0.5, fy: 0.5,
    stop: 0 #e2d4f5, stop: 0.45 #e2d4f5, stop: 0.55 transparent, stop: 1 transparent
  );
}

QStatusBar {
  background-color: #351d4d;
  border-top: 1px solid #6b35b0;
  color: #e2d4f5;
}

QStatusBar QLabel {
  padding-left: 1px;
  padding-right: 1px;
}

QTableView {
  background-color: #3d2159;
  border: 1px solid #6b35b0;
  border-radius: 4px;
  color: #e2d4f5;
  gridline-color: #6b35b0;
  selection-background-color: #6b35b0;
  selection-color: #e2d4f5;
}

QTableView::item:hover {
  background-color: #6b35b0;
}

QToolBar {
  background-color: #351d4d;
  border-bottom: 1px solid #6b35b0;
  padding: 4px;
  spacing: 4px;
}

QToolTip {
  background-color: #3d2159;
  border: 1px solid #6b35b0;
  border-radius: 4px;
  color: #e2d4f5;
  font-weight: bold;
}

SvgBoard {
  qproperty-coord: #e2d4f5;
  qproperty-inner_border: #6b35b0;
  qproperty-margin: #3d2159;
  qproperty-outer_border: #6b35b0;
  qproperty-square_dark: #583585;
  qproperty-square_dark_lastmove: #4a2b70;
  qproperty-square_light: #a359cc;
  qproperty-square_light_lastmove: #9450bd;
}
